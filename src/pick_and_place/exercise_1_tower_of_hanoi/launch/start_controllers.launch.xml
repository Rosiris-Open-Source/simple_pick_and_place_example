<launch>
     <arg name="use_sim_time" default="false" description="Use simulation time" />
     <!-- Joint State Broadcaster -->
     <node pkg="controller_manager" exec="spawner"
          args="joint_state_broadcaster --controller-manager /controller_manager">
          <param name="use_sim_time" value="$(var use_sim_time)" />
     </node>

     <!-- Arm Controller -->
     <node pkg="controller_manager" exec="spawner"
          args="joint_trajectory_controller -c /controller_manager">
          <param name="use_sim_time" value="$(var use_sim_time)" />
     </node>

     <!-- Gripper Controller -->
     <node pkg="controller_manager" exec="spawner"
          args="robotiq_gripper_controller -c /controller_manager">
          <param name="use_sim_time" value="$(var use_sim_time)" />
     </node>
</launch>