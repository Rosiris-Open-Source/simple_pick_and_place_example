<launch>
     <!-- Arguments-->
     <arg name="use_mock_hardware" default="true" description="Use mock hardware" />
     <arg name="scenario_file" default="tower_of_hanoi_scenario.yaml"
          description="Which scenario to load." />
     <!-- urdf and srdf paths -->
     <arg name="description_file_path"
          default="$(find-pkg-share pick_and_place_descriptions)/tower_of_hanoi/urdf/tower_of_hanoi.urdf.xacro"
          description="URDF/XACRO description file" />
     <arg name="semantic_description_file_path"
          default="$(find-pkg-share pick_and_place_descriptions)/tower_of_hanoi/srdf/tower_of_hanoi.srdf.xacro"
          description="SRDF semantic description file" />

     <arg name="start_gazebo" default="false" description="Start the gazebo simulation" />
     <!-- Compute use_sim_time: true if start_gazebo, else false -->
     <let name="use_sim_time" value="$(var start_gazebo)"/>

     <!-- Load robot description and publish -->
     <let name="robot_description_content"
          value="$(command '$(find-exec xacro) $(var description_file_path) \
                use_mock_hardware:=$(var use_mock_hardware)')" />
     <!-- Robot State Publisher -->
     <node pkg="robot_state_publisher" exec="robot_state_publisher" name="robot_state_publisher"
          output="both">
          <param name="robot_description" value="$(var robot_description_content)" />
     </node>

     <!-- Load SRDF -->
     <let name="robot_srdf_content"
          value="$(command '$(find-exec xacro) $(var semantic_description_file_path)')" />

     <!-- Start moveit and display rviz-->
     <include file="$(find-pkg-share exercise_1_tower_of_hanoi)/launch/moveit.launch.xml">
          <arg name="start_rviz" value="true" />
          <arg name="use_sim_time" value="$(var use_sim_time)" />
          <arg name="robot_description_content" value="$(var robot_description_content)" />
          <arg name="robot_srdf_content" value="$(var robot_srdf_content)" />
     </include>

     <!-- start ros2_control for joint state broadcaster-->
     <include file="$(find-pkg-share exercise_1_tower_of_hanoi)/launch/ros2_control.launch.xml"
          unless="$(var start_gazebo)" />
     <!-- Start controllers -->
     <include file="$(find-pkg-share exercise_1_tower_of_hanoi)/launch/start_controllers.launch.xml" />

     <!-- Planning Scene Manager -->
     <node pkg="scene_management" exec="planning_scene_manager_node" name="planning_scene_manager"
          output="screen">
          <param name="use_sim_time" value="$(var use_sim_time)" />
     </node>

     <!-- Load the scenario -->
     <node pkg="scene_management" exec="scenario_manager.py" name="scenario_manager" output="screen">
          <param
               name="path_to_scenario_file"
               value="package://exercise_1_tower_of_hanoi/scenarios/$(var scenario_file)" />
          <param name="use_sim_time" value="$(var use_sim_time)" />
     </node>

</launch>