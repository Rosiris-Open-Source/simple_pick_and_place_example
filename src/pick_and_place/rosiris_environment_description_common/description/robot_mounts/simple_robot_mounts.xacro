<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro name="cuboid_mount" params="prefix parent height width length *origin">

        <link name="${prefix}cuboid_mount_link">
            <visual>
                <origin xyz="${width/2} ${length/2} ${height/2}" rpy="0 0 0" />
                <geometry>
                    <box size="${width} ${length} ${height}"/>
                </geometry>
                <material name="black">
                    <color rgba="0.0 0.0 0.0 1.0"/>
                </material>
            </visual>
            <collision>
                <origin xyz="${width/2} ${length/2} ${height/2}" rpy="0 0 0" />
                <geometry>
                    <box size="${width} ${length} ${height}"/>
                </geometry>
                <material name="black2">
                    <color rgba="0.0 0.0 0.0 1.0"/>
                </material>
            </collision>
        </link>
        <joint name="${parent}cuboid_mount_joint" type="fixed">
            <parent link="${parent}"/>
            <child link="${prefix}cuboid_mount_link"/>
            <xacro:insert_block name="origin" />
        </joint>

        <link name="${prefix}cuboid_mount_middle_link"/>
        <joint name="cuboid_mount_middle_to_tabletop_joint" type="fixed">
            <parent link="${prefix}cuboid_mount_link"/>
            <child link="${prefix}cuboid_mount_middle_link"/>
            <origin xyz="${width/2} ${length/2} ${height}" rpy="0 0 0" />
        </joint>

  </xacro:macro>
</robot>
